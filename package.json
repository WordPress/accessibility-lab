{
    "name": "accessibility-lab",
    "version": "0.1.0",
    "description": "Accessibility Lab — Features and Experiments for WordPress.",
    "license": "GPL-2.0-or-later",
    "private": true,
    "engines": {
        "node": ">=24.21.0",
        "npm": ">=11.19.0"
    },
    "devEngines": {
        "runtime": {
            "name": "node",
            "version": ">=24.21.0"
        },
        "packageManager": {
            "name": "npm",
            "version": ">=11.19.0",
            "onFail": "error"
        }
    },
    "scripts": {
        "build": "wp-scripts build",
        "start": "wp-scripts start",
        "env:start": "wp-env start",
        "lint": "npm-run-all lint:*",
        "lint:css": "wp-scripts lint-style",
        "lint:js": "wp-scripts lint-js src",
        "lint:php": "composer run lint",
        "lint:phpstan": "composer phpstan",
        "format": "npm-run-all format:*",
        "format:css": "wp-scripts lint-style --fix",
        "format:js": "wp-scripts lint-js --fix",
        "format:php": "composer format"
    },
    "lint-staged": {
        "src/**/*.{js,jsx,ts,tsx}": "wp-scripts lint-js",
        "src/**/*.{css,scss}": "wp-scripts lint-style",
        "includes/**/*.php": "vendor/bin/phpcs",
        "*.php": "vendor/bin/phpcs"
    },
    "devDependencies": {
        "@wordpress/env": "^12.1.0",
        "@wordpress/scripts": "37.1.0",
        "@wordpress/stylelint-config": "^27.1.0",
        "lint-staged": "^17.6.0",
        "npm-run-all": "^4.1.5"
    },
    "dependencies": {
        "@base-ui/react": "1.9.0",
        "@wordpress/admin-ui": "3.1.0",
        "@wordpress/api-fetch": "8.1.0",
        "@wordpress/block-editor": "^20.0.0",
        "@wordpress/components": "44.0.0",
        "@wordpress/data": "11.1.0",
        "@wordpress/dataviews": "22.0.0",
        "@wordpress/editor": "^16.1.0",
        "@wordpress/element": "10.1.0",
        "@wordpress/hooks": "^5.1.0",
        "@wordpress/i18n": "7.1.0",
        "@wordpress/icons": "^20.0.0",
        "@wordpress/notices": "6.1.0",
        "@wordpress/plugins": "^8.1.0",
        "@wordpress/theme": "4.0.0"
    },
    "allowScripts": {
        "core-js-pure@3.51.0": true,
        "core-js@3.51.0": true,
        "fs-ext-extra-prebuilt@2.2.17": true,
        "@parcel/watcher@2.6.0": true
    }
}
